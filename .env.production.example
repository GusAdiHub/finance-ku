# Production Environment Configuration Example
# Copy this file to .env.production and replace all secrets before deploying

APP_ENV=production
DOMAIN_NAME=sakukeluarga.id

# Database
DB_NAME=finance_tracker
DB_USER=finance_app
DB_PASSWORD=REPLACE_WITH_VERY_STRONG_PASSWORD_MIN_32_CHARS
DB_ROOT_PASSWORD=REPLACE_WITH_ROOT_STRONG_PASSWORD_MIN_32_CHARS

# Backend Security
SECRET_KEY=REPLACE_WITH_GENERATED_RANDOM_SECRET_KEY_MIN_64_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=/app/private_uploads

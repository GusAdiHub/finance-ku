# Application Environment
APP_ENV=development
APP_NAME="Personal & Family Finance Tracker"
DEBUG=true

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finance_tracker

# Assembled Database URL (SQLAlchemy format using PyMySQL)
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Security
SECRET_KEY=generate_a_secure_random_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=private_uploads
MAX_UPLOAD_SIZE_MB=10

# OCR Configuration (Optional, set path if tesseract is not in system PATH)
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=
